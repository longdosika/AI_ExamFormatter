{
  "name": "ai-exam-formatter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/stamp-version.cjs",
    "predev": "node scripts/stamp-version.cjs",
    "dev": "node -r ./scripts/next-realpath-shim.cjs ./node_modules/next/dist/bin/next dev",
    "build": "node -r ./scripts/next-realpath-shim.cjs ./node_modules/next/dist/bin/next build",
    "start": "node -r ./scripts/next-realpath-shim.cjs ./node_modules/next/dist/bin/next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app components lib scripts --ext .ts,.tsx,.mjs,.cjs",
    "test": "node scripts/check-knowledge-vault.mjs && node scripts/test-environment-check.cjs && node scripts/test-parser.cjs && node scripts/test-source-answers.cjs && node scripts/test-local-vision-metrics.cjs && node scripts/test-local-vision-http.cjs && node scripts/test-ocr-contract.cjs && node scripts/test-ocr-client.cjs && node scripts/test-ollama-runtime.cjs && node scripts/test-diagram-contract.cjs && node scripts/test-provider-keys.cjs && node scripts/test-document-drafts.cjs && node scripts/test-experiment-stats.cjs && node scripts/test-import-history.cjs && node scripts/test-cases.cjs && node scripts/test-performance.cjs && node scripts/test-google.cjs && node scripts/test-pdf-assets.cjs",
    "test:quality": "node scripts/test-quality.cjs",
    "test:environment": "node scripts/test-environment-check.cjs",
    "test:e2e": "node scripts/test-e2e.cjs",
    "env:check": "node scripts/check-environment.mjs",
    "env:check:strict": "node scripts/check-environment.mjs --strict",
    "env:check:record": "node scripts/check-environment.mjs --write-evidence",
    "benchmark": "node scripts/benchmark-parser.cjs",
    "postinstall": "node scripts/sync-pdf-assets.cjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "google-auth-library": "^11.2.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.453.0",
    "next": "^14.2.15",
    "pdfjs-dist": "^3.11.174",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "playwright": "^1.64.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
