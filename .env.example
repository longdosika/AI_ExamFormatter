# Copy to .env.local; never commit secrets. Use the same origin as the browser.
APP_URL=http://localhost:3000
# Optional local dev port; bootstrap defaults to 3000.
PORT=3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# At least 32 random characters; generated locally, not supplied in chat.
GOOGLE_SESSION_SECRET=
# Browser-restricted API key and numeric Cloud project number for Google Picker.
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=

# OCR defaults to remote Typhoon. Keep the key server-side.
TYPHOON_OCR_API_KEY=
# For local Ollama, uncomment both lines; no remote key is required.
# TYPHOON_OCR_BASE_URL=http://127.0.0.1:11434/v1
# TYPHOON_OCR_MODEL=scb10x/typhoon-ocr1.5-3b
# Shared slots per server process: local defaults to 1, remote to 2.
# TYPHOON_OCR_CONCURRENCY=1

# Separate Gemini image analysis: extracts existing source answers, never solves.
GEMINI_API_KEY=
GEMINI_ANSWER_MODEL=gemini-3.8-flash
